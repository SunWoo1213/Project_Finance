{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./backend/.env)",
      "Read(./frontend/.env)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ],
    "ask": [
      "Bash(git reset --hard:*)",
      "Bash(git checkout -- :*)",
      "Bash(git checkout .:*)",
      "Bash(git clean:*)",
      "Bash(git push:*)",
      "Bash(rm:*)",
      "Bash(del:*)",
      "Bash(Remove-Item:*)",
      "Bash(docker compose down:*)",
      "Bash(docker volume rm:*)",
      "Bash(alembic downgrade:*)",
      "Bash(dropdb:*)"
    ],
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(pip install -r:*)",
      "Bash(uvicorn:*)",
      "Bash(alembic upgrade:*)",
      "Bash(alembic revision:*)",
      "Bash(npm install:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)"
    ]
  }
}
