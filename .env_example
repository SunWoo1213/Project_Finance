# Project Finance environment example
# Copy this file to .env and replace placeholder values locally.
# Do not commit real secrets.

# App metadata
PROJECT_NAME=Project Finance
API_V1_STR=/api/v1

# Database
# Backend expects the async SQLAlchemy PostgreSQL URL format.
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@localhost:5432/<db_name>

# AI / LLM
OPENAI_API_KEY=<your_openai_api_key>

# Market and macro data providers
ALPHA_VANTAGE_API_KEY=<your_alpha_vantage_api_key>
FRED_API_KEY=<your_fred_api_key>
ECOS_API_KEY=<your_ecos_api_key>
FMP_API_KEY=<your_financial_modeling_prep_api_key>
FINNHUB_API_KEY=<your_finnhub_api_key>

# Google login
# Use the same Google OAuth client ID for backend verification and Vite frontend.
# Vite reads env files from the frontend project root, so mirror VITE_GOOGLE_CLIENT_ID
# in frontend/.env when running the frontend separately.
GOOGLE_CLIENT_ID=<your_google_client_id>
VITE_GOOGLE_CLIENT_ID=<your_google_client_id>

# JWT authentication
SECRET_KEY=<replace_with_a_long_random_secret>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Runtime tasks
ENABLE_MARKET_WARMUP=true
ENABLE_SCHEDULER=true
REPORT_SCHEDULER_COVERAGE=conservative
REPORT_SCHEDULER_MAX_REPORTS_PER_RUN=20
REPORT_SCHEDULER_ASSET_COOLDOWN_HOURS=24
ENABLE_LLM_REPORT_CRITICS=false
REPORT_CRITIC_MODE=deterministic

# Favorite asset notifications
# Keep provider tokens and SMTP credentials backend-only. Do not expose them as VITE_ variables.
ENABLE_NOTIFICATION_SCHEDULER=false
NOTIFICATION_EVALUATION_INTERVAL_MINUTES=10
NOTIFICATION_DELIVERY_INTERVAL_MINUTES=1
NOTIFICATION_DEFAULT_PRICE_THRESHOLD_PERCENT=3
NOTIFICATION_DEFAULT_COOLDOWN_MINUTES=180
TELEGRAM_BOT_TOKEN=<your_telegram_bot_token>
TELEGRAM_WEBHOOK_SECRET=<your_telegram_webhook_secret>
EMAIL_PROVIDER=
EMAIL_FROM_ADDRESS=<alerts@example.com>
GMAIL_CLIENT_ID=<your_gmail_client_id>
GMAIL_CLIENT_SECRET=<your_gmail_client_secret>
GMAIL_REFRESH_TOKEN=<your_gmail_refresh_token>
EMAIL_SMTP_HOST=<smtp_host>
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=<smtp_username>
EMAIL_SMTP_PASSWORD=<smtp_password>
EMAIL_SMTP_USE_TLS=true
