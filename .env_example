# Project Finance 환경 변수 예시
# 이 파일을 .env로 복사한 뒤 <...> placeholder를 실제 로컬 값으로 바꿔서 사용한다.
# 실제 API 키, DB 비밀번호, JWT secret, provider secret은 커밋하지 않는다.

# .env에 채워야 할 환경변수 목록
# 아래 목록은 빠른 확인용 변수명 모음이다. 실제 값과 설명은 이어지는 섹션별 예시를 기준으로 채운다.
# - PROJECT_NAME
# - API_V1_STR
# - ENVIRONMENT
# - VITE_API_BASE_URL
# - POSTGRES_USER
# - POSTGRES_PASSWORD
# - POSTGRES_DB
# - POSTGRES_PORT
# - DATABASE_URL
# - ENABLE_DB_SCHEMA_BOOTSTRAP
# - SQLALCHEMY_ECHO
# - DB_POOL_PRE_PING
# - DB_PREPARED_STATEMENT_CACHE_SIZE
# - BACKEND_CORS_ORIGINS
# - BACKEND_CORS_ORIGIN_REGEX
# - LOCAL_CORS_ORIGINS
# - OPENAI_API_KEY
# - ALPHA_VANTAGE_API_KEY
# - FRED_API_KEY
# - ECOS_API_KEY
# - FMP_API_KEY
# - FINNHUB_API_KEY
# - GOOGLE_CLIENT_ID
# - VITE_GOOGLE_CLIENT_ID
# - SECRET_KEY
# - ALGORITHM
# - ACCESS_TOKEN_EXPIRE_MINUTES
# - ENABLE_MARKET_WARMUP
# - ENABLE_SCHEDULER
# - REPORT_SCHEDULER_COVERAGE
# - REPORT_SCHEDULER_INTERVAL_HOURS
# - REPORT_SCHEDULER_MAX_REPORTS_PER_RUN
# - REPORT_SCHEDULER_ASSET_COOLDOWN_HOURS
# - REPORT_SCHEDULER_TARGET_TICKERS
# - ENABLE_LLM_REPORT_CRITICS
# - REPORT_CRITIC_MODE
# - PAYMENT_PROVIDER
# - PAYMENT_WEBHOOK_SECRET
# - PAYMENT_PLUS_PLAN_ID
# - PAYMENT_PRO_PLAN_ID
# - PAYMENT_MOCK_CHECKOUT_BASE_URL
# - ENABLE_NOTIFICATION_SCHEDULER
# - NOTIFICATION_EVALUATION_INTERVAL_MINUTES
# - NOTIFICATION_DELIVERY_INTERVAL_MINUTES
# - NOTIFICATION_DEFAULT_PRICE_THRESHOLD_PERCENT
# - NOTIFICATION_DEFAULT_COOLDOWN_MINUTES
# - TELEGRAM_BOT_TOKEN
# - TELEGRAM_WEBHOOK_SECRET
# - EMAIL_PROVIDER
# - EMAIL_FROM_ADDRESS
# - GMAIL_CLIENT_ID
# - GMAIL_CLIENT_SECRET
# - GMAIL_REFRESH_TOKEN

# App metadata
# PROJECT_NAME: FastAPI 앱 이름. 보통 그대로 둔다.
# API_V1_STR: v1 API prefix가 필요할 때 쓰는 값. 현재 주요 라우트는 /api/... 형태도 함께 사용한다.
# ENVIRONMENT: development, staging, production 같은 런타임 구분값.
PROJECT_NAME=Project Finance
API_V1_STR=/api/v1
ENVIRONMENT=development

# Frontend public runtime
# VITE_API_BASE_URL: 브라우저가 호출할 FastAPI backend origin.
# - 로컬: http://localhost:8000
# - 운영: https://api.example.com 처럼 배포된 backend 주소
# VITE_ 변수는 브라우저에 노출되므로 secret을 넣지 않는다.
# Vite는 frontend/.env도 읽으므로 frontend만 따로 실행할 때는 같은 값을 frontend/.env에도 둔다.
VITE_API_BASE_URL=http://localhost:8000

# Database
# POSTGRES_*: local docker-compose PostgreSQL 초기화 값.
# - 이 값들은 로컬 개발용 placeholder이며 실제 운영 DB credential이 아니다.
# - docker-compose.yml은 이 값을 읽어 컨테이너 DB를 초기화한다.
# - 기존 postgres_data volume이 이미 있으면 POSTGRES_* 변경만으로 DB가 재초기화되지 않는다.
# DATABASE_URL: async SQLAlchemy PostgreSQL 접속 URL.
# - 로컬 docker-compose DB를 쓰면 POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB와 같은 의미로 맞춘다.
# - PostgreSQL runtime은 postgresql+asyncpg:// scheme을 사용한다.
# - 테스트용 SQLite는 sqlite+aiosqlite:// scheme을 사용한다.
# Supabase 같은 hosted DB는 provider가 준 asyncpg 호환 PostgreSQL URL로 설정한다.
# ENABLE_DB_SCHEMA_BOOTSTRAP: 로컬 편의용 create_all 사용 여부. 운영/스테이징은 false 권장.
# SQLALCHEMY_ECHO: SQL 로그 출력 여부. 운영에서는 false 유지.
# DB_POOL_PRE_PING: 죽은 DB 연결을 재사용하지 않도록 사전 ping. 보통 true 유지.
# DB_PREPARED_STATEMENT_CACHE_SIZE: Supabase pooler 등에서 prepared statement 문제가 있을 때만 조정한다. 기본은 빈 값.
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=<local_postgres_password>
POSTGRES_DB=finance_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://finance_user:<local_postgres_password>@localhost:5432/finance_db
ENABLE_DB_SCHEMA_BOOTSTRAP=true
SQLALCHEMY_ECHO=false
DB_POOL_PRE_PING=true
DB_PREPARED_STATEMENT_CACHE_SIZE=

# Backend CORS
# BACKEND_CORS_ORIGINS: credentialed 요청을 허용할 frontend origin 목록. 쉼표로 구분한다.
# 예: https://project-finance.vercel.app,https://staging-project-finance.vercel.app
# BACKEND_CORS_ORIGIN_REGEX: Vercel preview URL 같은 패턴 허용이 필요할 때만 regex를 넣는다.
# LOCAL_CORS_ORIGINS: 로컬 Vite 개발 서버 origin. 일반적으로 그대로 둔다.
BACKEND_CORS_ORIGINS=
BACKEND_CORS_ORIGIN_REGEX=
LOCAL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI / LLM
# OPENAI_API_KEY: AI 리포트/챗봇에서 OpenAI API를 호출할 때 필요한 backend-only 키.
# 비용이 발생할 수 있으므로 로컬 테스트에서는 필요한 경우에만 설정한다.
OPENAI_API_KEY=<your_openai_api_key>

# Market and macro data providers
# 외부 시장/거시 데이터 provider API 키.
# 비어 있어도 일부 데이터는 fallback 또는 무료 경로로 동작할 수 있지만, 품질과 coverage가 제한될 수 있다.
# 각 값은 provider dashboard에서 발급받은 backend-only 키를 넣는다.
ALPHA_VANTAGE_API_KEY=<your_alpha_vantage_api_key>
FRED_API_KEY=<your_fred_api_key>
ECOS_API_KEY=<your_ecos_api_key>
FMP_API_KEY=<your_financial_modeling_prep_api_key>
FINNHUB_API_KEY=<your_finnhub_api_key>

# Google login
# GOOGLE_CLIENT_ID: backend가 Google ID token audience를 검증할 OAuth client ID.
# VITE_GOOGLE_CLIENT_ID: frontend Google Identity Services 버튼에 쓰는 같은 client ID.
# Google Cloud Console에서 Web application client를 만들고 허용 origin/callback을 현재 frontend 주소에 맞춘다.
# VITE_GOOGLE_CLIENT_ID는 브라우저에 노출되는 public identifier이며, client secret이 아니다.
GOOGLE_CLIENT_ID=<your_google_client_id>
VITE_GOOGLE_CLIENT_ID=<your_google_client_id>

# JWT authentication
# SECRET_KEY: 앱 JWT 서명용 긴 랜덤 문자열. 운영에서는 반드시 새로 생성한 강한 값을 사용한다.
# ALGORITHM: JWT 서명 알고리즘. backend 코드와 맞춰 HS256 유지.
# ACCESS_TOKEN_EXPIRE_MINUTES: access token 만료 시간. 10080은 7일이다.
SECRET_KEY=<replace_with_a_long_random_secret>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Runtime tasks
# ENABLE_MARKET_WARMUP: backend 시작 시 시장 데이터 캐시를 즉시 채울지 여부.
# ENABLE_SCHEDULER: APScheduler 기반 가격/뉴스/리포트 작업 실행 여부.
# 첫 hosted smoke에서는 비용과 외부 API 부하를 줄이기 위해 둘 다 false로 시작하는 것을 권장한다.
# REPORT_SCHEDULER_*: 저장형 AI 리포트 생성 주기와 대상 ticker 제어값.
# 사용자 화면/챗봇 요청은 직접 리포트 생성을 호출하지 않고 저장된 scheduled report를 읽는 것이 목표 규칙이다.
# ENABLE_LLM_REPORT_CRITICS: 추가 LLM critic agent 사용 여부. 비용 승인 전 false 유지.
# REPORT_CRITIC_MODE: deterministic 품질 검사를 기본으로 둔다.
ENABLE_MARKET_WARMUP=true
ENABLE_SCHEDULER=true
REPORT_SCHEDULER_COVERAGE=conservative
REPORT_SCHEDULER_INTERVAL_HOURS=6
REPORT_SCHEDULER_MAX_REPORTS_PER_RUN=5
REPORT_SCHEDULER_ASSET_COOLDOWN_HOURS=6
REPORT_SCHEDULER_TARGET_TICKERS=DGS10,XAU,BTC-USD,NVDA,005930.KS
ENABLE_LLM_REPORT_CRITICS=false
REPORT_CRITIC_MODE=deterministic

# Payment provider boundary
# PAYMENT_PROVIDER: 실제 결제 provider 이름. 아직 provider 미확정이면 비워둔다.
# PAYMENT_WEBHOOK_SECRET: provider webhook 서명 검증용 secret. provider dashboard에서 발급받는다.
# PAYMENT_PLUS_PLAN_ID, PAYMENT_PRO_PLAN_ID: provider에 생성한 Plus/Pro 상품 또는 요금제 ID.
# PAYMENT_MOCK_CHECKOUT_BASE_URL: mock provider 사용 시 checkout redirect base URL.
# 실제 운영 결제 연동 전에는 VAT, 환불, 실패 결제, downgrade 정책 결정이 필요하다.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=<your_payment_webhook_secret>
PAYMENT_PLUS_PLAN_ID=<provider_plus_plan_id>
PAYMENT_PRO_PLAN_ID=<provider_pro_plan_id>
PAYMENT_MOCK_CHECKOUT_BASE_URL=http://localhost:5173/billing

# Favorite asset notifications
# 관심자산 알림 scheduler와 발송 채널 설정.
# provider token과 Gmail token은 backend-only 값이며 VITE_ 변수로 만들지 않는다.
# ENABLE_NOTIFICATION_SCHEDULER: 알림 평가/발송 job 실행 여부. 운영 발송 정책 확정 전 false 유지.
# NOTIFICATION_*: 평가 주기, 발송 주기, 기본 가격 변동 임계치, 재알림 cooldown.
# TELEGRAM_*: Telegram bot token과 webhook 검증 secret. BotFather와 backend webhook 설정 후 입력한다.
# EMAIL_PROVIDER: 이메일 알림 provider. 현재 구현은 gmail만 지원한다.
# EMAIL_FROM_ADDRESS: Gmail API로 발송할 발신자 주소.
# GMAIL_*: Gmail API 발송을 사용할 때 필요한 OAuth client/refresh token.
ENABLE_NOTIFICATION_SCHEDULER=false
NOTIFICATION_EVALUATION_INTERVAL_MINUTES=10
NOTIFICATION_DELIVERY_INTERVAL_MINUTES=1
NOTIFICATION_DEFAULT_PRICE_THRESHOLD_PERCENT=3
NOTIFICATION_DEFAULT_COOLDOWN_MINUTES=180
TELEGRAM_BOT_TOKEN=<your_telegram_bot_token>
TELEGRAM_WEBHOOK_SECRET=<your_telegram_webhook_secret>
EMAIL_PROVIDER=gmail
EMAIL_FROM_ADDRESS=<alerts@example.com>
GMAIL_CLIENT_ID=<your_gmail_client_id>
GMAIL_CLIENT_SECRET=<your_gmail_client_secret>
GMAIL_REFRESH_TOKEN=<your_gmail_refresh_token>
