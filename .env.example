# Project Finance 환경 변수 예시
# 이 파일을 .env로 복사한 뒤 <...> placeholder를 실제 로컬 값으로 바꿔서 사용한다.
# 실제 API 키, DB 비밀번호, JWT secret, provider secret은 커밋하지 않는다.

# .env에 채워야 할 환경변수 목록
# 아래 목록은 빠른 확인용 변수명 모음이다. 실제 값과 설명은 이어지는 섹션별 예시를 기준으로 채운다.
# - PROJECT_NAME
# - API_V1_STR
# - ENVIRONMENT
# - VITE_API_BASE_URL
# - POSTGRES_USER
# - POSTGRES_PASSWORD
# - POSTGRES_DB
# - POSTGRES_PORT
# - DATABASE_URL
# - POSTGRES_URL_NON_POOLING
# - POSTGRES_URL
# - ENABLE_DB_SCHEMA_BOOTSTRAP
# - SQLALCHEMY_ECHO
# - DB_POOL_PRE_PING
# - DB_PREPARED_STATEMENT_CACHE_SIZE
# - BACKEND_CORS_ORIGINS
# - BACKEND_CORS_ORIGIN_REGEX
# - LOCAL_CORS_ORIGINS
# - OPENAI_API_KEY
# - ALPHA_VANTAGE_API_KEY
# - FRED_API_KEY
# - ECOS_API_KEY
# - FMP_API_KEY
# - FMP_FETCH_TIMEOUT_SECONDS
# - FMP_DAILY_CALL_BUDGET
# - FINNHUB_API_KEY
# - COINGECKO_DEMO_API_KEY
# - DATA_GO_KR_API_KEY
# - STOOQ_API_KEY
# - ENABLE_STOOQ_FALLBACK
# - GOOGLE_CLIENT_ID
# - VITE_GOOGLE_CLIENT_ID
# - SECRET_KEY
# - ALGORITHM
# - ACCESS_TOKEN_EXPIRE_MINUTES
# - ENABLE_MARKET_WARMUP
# - ENABLE_SCHEDULER
# - ENABLE_AI_REPORT_GENERATION
# - MARKET_PRICES_REFRESH_MINUTES
# - MARKET_NEWS_REFRESH_MINUTES
# - MARKET_LATEST_CONTEXT_TTL_MINUTES
# - MARKET_LIVE_TICKERS
# - REPORT_SCHEDULER_COVERAGE
# - REPORT_SCHEDULER_INTERVAL_HOURS
# - REPORT_SCHEDULER_MAX_REPORTS_PER_RUN
# - REPORT_SCHEDULER_ASSET_COOLDOWN_HOURS
# - REPORT_SCHEDULER_TARGET_TICKERS
# - ENABLE_LLM_REPORT_CRITICS
# - REPORT_CRITIC_MODE
# - PAYMENT_PROVIDER
# - PAYMENT_WEBHOOK_SECRET
# - PAYMENT_PLUS_PLAN_ID
# - PAYMENT_PRO_PLAN_ID
# - PAYMENT_MOCK_CHECKOUT_BASE_URL
# - TOSS_API_BASE_URL
# - TOSS_CLIENT_KEY
# - TOSS_SECRET_KEY
# - TOSS_PLUS_AMOUNT_KRW
# - TOSS_PRO_AMOUNT_KRW
# - TOSS_BILLING_SUCCESS_URL
# - TOSS_BILLING_FAIL_URL
# - ENABLE_BILLING_SCHEDULER
# - BILLING_RENEWAL_INTERVAL_MINUTES
# - BILLING_RETRY_LIMIT
# - BILLING_RETRY_BACKOFF_HOURS
# - ENABLE_NOTIFICATION_SCHEDULER
# - NOTIFICATION_EVALUATION_INTERVAL_MINUTES
# - NOTIFICATION_DELIVERY_INTERVAL_MINUTES
# - NOTIFICATION_DEFAULT_PRICE_THRESHOLD_PERCENT
# - NOTIFICATION_DEFAULT_COOLDOWN_MINUTES
# - TELEGRAM_BOT_TOKEN
# - TELEGRAM_WEBHOOK_SECRET
# - EMAIL_PROVIDER
# - EMAIL_FROM_ADDRESS
# - GMAIL_CLIENT_ID
# - GMAIL_CLIENT_SECRET
# - GMAIL_REFRESH_TOKEN

# App metadata
# PROJECT_NAME: FastAPI 앱 이름. 보통 그대로 둔다.
# API_V1_STR: v1 API prefix가 필요할 때 쓰는 값. 현재 주요 라우트는 /api/... 형태도 함께 사용한다.
# ENVIRONMENT: development, staging, production 같은 런타임 구분값.
PROJECT_NAME=Project Finance
API_V1_STR=/api/v1
ENVIRONMENT=development

# Frontend public runtime
# VITE_API_BASE_URL: 브라우저가 호출할 FastAPI backend origin.
# - 로컬: http://localhost:8000
# - 운영: https://api.example.com 처럼 배포된 backend 주소
# VITE_ 변수는 브라우저에 노출되므로 secret을 넣지 않는다.
# Vite는 frontend/.env도 읽으므로 frontend만 따로 실행할 때는 같은 값을 frontend/.env에도 둔다.
VITE_API_BASE_URL=http://localhost:8000

# Database
# POSTGRES_*: local docker-compose PostgreSQL 초기화 값.
# - 이 값들은 로컬 개발용 placeholder이며 실제 운영 DB credential이 아니다.
# - docker-compose.yml은 이 값을 읽어 컨테이너 DB를 초기화한다.
# - 기존 postgres_data volume이 이미 있으면 POSTGRES_* 변경만으로 DB가 재초기화되지 않는다.
# DATABASE_URL: async SQLAlchemy PostgreSQL 접속 URL.
# - 로컬 docker-compose DB를 쓰면 POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB와 같은 의미로 맞춘다.
# - PostgreSQL runtime은 postgresql+asyncpg:// scheme을 사용한다.
# - Supabase/Vercel에서 받은 postgresql:// 또는 postgres:// URL을 넣어도 backend가 postgresql+asyncpg://로 정규화한다.
# - 테스트용 SQLite는 sqlite+aiosqlite:// scheme을 사용한다.
# POSTGRES_URL_NON_POOLING, POSTGRES_URL: Vercel/Supabase integration이 제공할 수 있는 optional fallback URL.
# - DATABASE_URL이 비어 있을 때 backend는 POSTGRES_URL_NON_POOLING을 먼저 보고, 없으면 POSTGRES_URL을 사용한다.
# - 이 값들은 password가 포함된 secret이므로 frontend/.env 또는 VITE_ 변수로 만들지 않는다.
# - local docker-compose용 POSTGRES_* 값과 provider-issued POSTGRES_* 값을 같은 .env에 섞지 않는다.
# - /db-check 진단에는 선택된 변수명(source), scheme, host, port만 표시되고 credential은 표시되지 않는다.
# ENABLE_DB_SCHEMA_BOOTSTRAP: 로컬 편의용 create_all 사용 여부. 운영/스테이징은 false 권장.
# SQLALCHEMY_ECHO: SQL 로그 출력 여부. 운영에서는 false 유지.
# DB_POOL_PRE_PING: 죽은 DB 연결을 재사용하지 않도록 사전 ping. 보통 true 유지.
# DB_PREPARED_STATEMENT_CACHE_SIZE: Supabase pooler 등에서 prepared statement 문제가 있을 때만 조정한다. 기본은 빈 값.
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=<local_postgres_password>
POSTGRES_DB=finance_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://finance_user:<local_postgres_password>@localhost:5432/finance_db
POSTGRES_URL_NON_POOLING=
POSTGRES_URL=
ENABLE_DB_SCHEMA_BOOTSTRAP=true
SQLALCHEMY_ECHO=false
DB_POOL_PRE_PING=true
DB_PREPARED_STATEMENT_CACHE_SIZE=

# Hosted smoke override preset
# 아래 값들은 Vercel frontend + persistent backend + Supabase PostgreSQL 첫 배포 검증 때 backend host에 넣는 권장값이다.
# 실제 secret 값은 provider dashboard 또는 backend host secret store에만 입력한다.
# DATABASE_URL 또는 POSTGRES_URL_NON_POOLING에는 Supabase connection string을 넣되 문서/채팅/로그에 출력하지 않는다.
# ENVIRONMENT=staging
# ENABLE_DB_SCHEMA_BOOTSTRAP=false
# ENABLE_MARKET_WARMUP=false
# ENABLE_SCHEDULER=false
# ENABLE_AI_REPORT_GENERATION=false
# ENABLE_LLM_REPORT_CRITICS=false
# ENABLE_NOTIFICATION_SCHEDULER=false
# SQLALCHEMY_ECHO=false
# DB_POOL_PRE_PING=true

# Backend CORS
# BACKEND_CORS_ORIGINS: credentialed 요청을 허용할 frontend origin 목록. 쉼표로 구분한다.
# 예: https://project-finance.vercel.app,https://staging-project-finance.vercel.app
# BACKEND_CORS_ORIGIN_REGEX: Vercel preview URL 같은 패턴 허용이 필요할 때만 regex를 넣는다.
# LOCAL_CORS_ORIGINS: 로컬 Vite 개발 서버 origin. 일반적으로 그대로 둔다.
BACKEND_CORS_ORIGINS=
BACKEND_CORS_ORIGIN_REGEX=
LOCAL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI / LLM
# OPENAI_API_KEY: AI 리포트/챗봇에서 OpenAI API를 호출할 때 필요한 backend-only 키.
# 비용이 발생할 수 있으므로 로컬 테스트에서는 필요한 경우에만 설정한다.
OPENAI_API_KEY=<your_openai_api_key>

# Market and macro data providers
# 외부 시장/거시 데이터 provider API 키.
# 비어 있어도 일부 데이터는 fallback 또는 무료 경로로 동작할 수 있지만, 품질과 coverage가 제한될 수 있다.
# 각 값은 provider dashboard에서 발급받은 backend-only 키를 넣는다.
ALPHA_VANTAGE_API_KEY=<your_alpha_vantage_api_key>
FRED_API_KEY=<your_fred_api_key>
ECOS_API_KEY=<your_ecos_api_key>
FMP_API_KEY=<your_financial_modeling_prep_api_key>
FINNHUB_API_KEY=<your_finnhub_api_key>
# COINGECKO_DEMO_API_KEY: 암호화폐 현재가/히스토리용 Demo API key. 비어 있으면 crypto 데이터는 빈 응답으로 degrade된다.
# DATA_GO_KR_API_KEY: 공공데이터포털 금융위원회 주식시세정보/지수시세정보 serviceKey.
# FMP_FETCH_TIMEOUT_SECONDS: FMP EOD quote/history/profile 1회 호출 timeout. 기본 10초.
# FMP_DAILY_CALL_BUDGET: FMP 무료 Basic 250/day 한도에 여유를 두기 위한 process-local 일일 budget. 기본 180.
# STOOQ_API_KEY: opt-in fallback용 Stooq daily CSV key. ENABLE_STOOQ_FALLBACK=false이면 호출하지 않는다.
# ENABLE_STOOQ_FALLBACK: FMP/open.er-api.com 실패 시 Stooq daily CSV를 보조 fallback으로 쓸지 여부. 기본 false.
# STOOQ_FETCH_TIMEOUT_SECONDS: opt-in Stooq daily CSV 1회 호출 timeout. 기본 12초.
# FMP Basic 무료 플랜 데이터는 EOD/delayed 성격이며 공개 상용 표시/재배포 전에는 provider license를 재확인한다.
# open.er-api.com 환율 provider는 별도 키가 없지만 1일 1회 갱신 기준환율이며 attribution/source 표시가 필요하다.
COINGECKO_DEMO_API_KEY=<your_coingecko_demo_api_key>
DATA_GO_KR_API_KEY=<your_data_go_kr_service_key>
FMP_FETCH_TIMEOUT_SECONDS=10
FMP_DAILY_CALL_BUDGET=180
STOOQ_API_KEY=<your_stooq_api_key>
ENABLE_STOOQ_FALLBACK=false
STOOQ_FETCH_TIMEOUT_SECONDS=12

# Google login
# GOOGLE_CLIENT_ID: backend가 Google ID token audience를 검증할 OAuth client ID.
# VITE_GOOGLE_CLIENT_ID: frontend Google Identity Services 버튼에 쓰는 같은 client ID.
# Google Cloud Console에서 Web application client를 만들고 허용 origin/callback을 현재 frontend 주소에 맞춘다.
# VITE_GOOGLE_CLIENT_ID는 브라우저에 노출되는 public identifier이며, client secret이 아니다.
GOOGLE_CLIENT_ID=<your_google_client_id>
VITE_GOOGLE_CLIENT_ID=<your_google_client_id>

# JWT authentication
# SECRET_KEY: 앱 JWT 서명용 긴 랜덤 문자열. 운영에서는 반드시 새로 생성한 강한 값을 사용한다.
# ALGORITHM: JWT 서명 알고리즘. backend 코드와 맞춰 HS256 유지.
# ACCESS_TOKEN_EXPIRE_MINUTES: access token 만료 시간. 10080은 7일이다.
SECRET_KEY=<replace_with_a_long_random_secret>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Runtime tasks
# ENABLE_MARKET_WARMUP: backend 시작 시 시장 데이터 캐시를 즉시 채울지 여부.
# ENABLE_SCHEDULER: APScheduler 기반 가격/뉴스/알림/리포트 작업 실행 여부.
# ENABLE_AI_REPORT_GENERATION: scheduler가 켜져 있어도 AI 리포트 생성 job과 서비스 호출을 허용할지 여부.
# 첫 hosted smoke에서는 비용과 외부 API 부하를 줄이기 위해 market warm-up, scheduler, AI report generation을 false로 시작하는 것을 권장한다.
# REPORT_SCHEDULER_*: 저장형 AI 리포트 생성 주기와 대상 ticker 제어값.
# REPORT_SCHEDULER_STARTUP_DELAY_SECONDS: 앱 시작 직후 market warm-up/provider queue가 먼저 돌도록 startup 리포트 job을 지연한다.
# 사용자 화면/챗봇 요청은 직접 리포트 생성을 호출하지 않고 저장된 scheduled report를 읽는 것이 목표 규칙이다.
# ENABLE_LLM_REPORT_CRITICS: 추가 LLM critic agent 사용 여부. 비용 승인 전 false 유지.
# REPORT_CRITIC_MODE: deterministic 품질 검사를 기본으로 둔다.
ENABLE_MARKET_WARMUP=true
ENABLE_SCHEDULER=true
ENABLE_AI_REPORT_GENERATION=true
REPORT_SCHEDULER_COVERAGE=conservative
REPORT_SCHEDULER_INTERVAL_HOURS=6
REPORT_SCHEDULER_STARTUP_DELAY_SECONDS=180
REPORT_SCHEDULER_MAX_REPORTS_PER_RUN=5
REPORT_SCHEDULER_ASSET_COOLDOWN_HOURS=6
REPORT_SCHEDULER_TARGET_TICKERS=DGS10,XAU,BTC-USD,NVDA,005930.KS
ENABLE_LLM_REPORT_CRITICS=false
REPORT_CRITIC_MODE=deterministic

# Market data refresh cadence (리포트 제외, 사용자 노출 일반 데이터)
# 사용자에게 보여주는 시장 데이터의 갱신 주기를 분 단위로 직접 조정한다.
# ENABLE_SCHEDULER=true일 때만 scheduler 기반 가격/뉴스 갱신이 동작한다.
# 세 값 모두 분 단위이며 최소 1로 강제된다(0/음수 입력 시 1로 보정).
# 값은 프로세스 시작 시 로드되므로 변경 후에는 backend 재시작이 필요하다.
# 간격을 크게 줄이면 Finnhub/CoinGecko/공공데이터포털/Stooq 등 외부 provider 호출 빈도와 rate limit 위험이 늘어난다.
# MARKET_PRICES_REFRESH_MINUTES: 시세(prices) cache 갱신 간격(분). 기본 5.
# MARKET_NEWS_REFRESH_MINUTES: 뉴스(news) cache 갱신 간격(분). 기본 60(=1시간).
# MARKET_LATEST_CONTEXT_TTL_MINUTES: 종목 상세 latest-context cache 유효시간(분). 기본 10.
# MARKET_LIVE_TICKERS: 실제 provider 호출을 허용할 ticker 목록. 무료 API 데모 기본값은 5개만 live이고 나머지는 mock 데이터로 응답한다. 전체 live가 필요하면 *로 설정한다.
# MARKET_PRICE_FETCH_TIMEOUT_SECONDS: 한 자산의 가격 수집 전체 timeout(초). 기본 55.
# MARKET_NEWS_FETCH_TIMEOUT_SECONDS: 한 심볼의 뉴스 수집 전체 timeout(초). 기본 20.
# FMP_FETCH_TIMEOUT_SECONDS: FMP quote/history/profile 단일 호출 timeout(초). 기본 10.
# FMP_DAILY_CALL_BUDGET: FMP 일일 process-local 호출 budget. 기본 180, 0이면 FMP 호출 skip.
# ENABLE_STOOQ_FALLBACK: Stooq daily CSV fallback opt-in. 기본 false.
# STOOQ_FETCH_TIMEOUT_SECONDS: opt-in Stooq 단일 호출 timeout(초). 기본 12.
MARKET_PRICES_REFRESH_MINUTES=5
MARKET_NEWS_REFRESH_MINUTES=60
MARKET_LATEST_CONTEXT_TTL_MINUTES=10
MARKET_LIVE_TICKERS=DGS10,XAU,BTC-USD,NVDA,005930.KS
MARKET_PRICE_FETCH_TIMEOUT_SECONDS=55
MARKET_NEWS_FETCH_TIMEOUT_SECONDS=20

# Payment provider boundary
# PAYMENT_PROVIDER: 실제 결제 provider 이름. 아직 provider 미확정이면 비워둔다.
# PAYMENT_WEBHOOK_SECRET: provider webhook 서명 검증용 secret. provider dashboard에서 발급받는다.
# PAYMENT_PLUS_PLAN_ID, PAYMENT_PRO_PLAN_ID: provider에 생성한 Plus/Pro 상품 또는 요금제 ID.
# PAYMENT_MOCK_CHECKOUT_BASE_URL: mock provider 사용 시 checkout redirect base URL.
# TOSS_CLIENT_KEY: Toss JS SDK에 전달되는 public client key. secret은 아니지만 frontend source에 하드코딩하지 않는다.
# TOSS_SECRET_KEY: Toss Core API 호출용 backend-only secret. VITE_ 변수나 문서에 넣지 않는다.
# TOSS_PLUS_AMOUNT_KRW, TOSS_PRO_AMOUNT_KRW: backend가 검증하고 승인에 사용하는 월 결제 금액.
# TOSS_BILLING_SUCCESS_URL, TOSS_BILLING_FAIL_URL: 배포 환경에서 고정 callback URL을 강제해야 할 때 사용한다.
# ENABLE_BILLING_SCHEDULER: Toss 정기 결제 scheduler 실행 여부. 실제 돈을 청구하므로 기본 false 유지.
# 실제 운영 결제 연동 전에는 VAT, 환불, 실패 결제, downgrade 정책 결정이 필요하다.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=<your_payment_webhook_secret>
PAYMENT_PLUS_PLAN_ID=<provider_plus_plan_id>
PAYMENT_PRO_PLAN_ID=<provider_pro_plan_id>
PAYMENT_MOCK_CHECKOUT_BASE_URL=http://localhost:5173/billing
TOSS_API_BASE_URL=https://api.tosspayments.com
TOSS_CLIENT_KEY=<your_toss_client_key>
TOSS_SECRET_KEY=<your_toss_secret_key>
TOSS_PLUS_AMOUNT_KRW=1000
TOSS_PRO_AMOUNT_KRW=3000
TOSS_BILLING_SUCCESS_URL=
TOSS_BILLING_FAIL_URL=
ENABLE_BILLING_SCHEDULER=false
BILLING_RENEWAL_INTERVAL_MINUTES=60
BILLING_RETRY_LIMIT=3
BILLING_RETRY_BACKOFF_HOURS=24

# Favorite asset notifications
# 관심자산 알림 scheduler와 발송 채널 설정.
# provider token과 Gmail token은 backend-only 값이며 VITE_ 변수로 만들지 않는다.
# ENABLE_NOTIFICATION_SCHEDULER: 알림 평가/발송 job 실행 여부. 운영 발송 정책 확정 전 false 유지.
# NOTIFICATION_*: 평가 주기, 발송 주기, 기본 가격 변동 임계치, 재알림 cooldown.
# TELEGRAM_*: Telegram bot token과 webhook 검증 secret. BotFather와 backend webhook 설정 후 입력한다.
# EMAIL_PROVIDER: 이메일 알림 provider. 현재 구현은 gmail만 지원한다.
# EMAIL_FROM_ADDRESS: Gmail API로 발송할 발신자 주소.
# GMAIL_*: Gmail API 발송을 사용할 때 필요한 OAuth client/refresh token.
ENABLE_NOTIFICATION_SCHEDULER=false
NOTIFICATION_EVALUATION_INTERVAL_MINUTES=10
NOTIFICATION_DELIVERY_INTERVAL_MINUTES=1
NOTIFICATION_DEFAULT_PRICE_THRESHOLD_PERCENT=3
NOTIFICATION_DEFAULT_COOLDOWN_MINUTES=180
TELEGRAM_BOT_TOKEN=<your_telegram_bot_token>
TELEGRAM_WEBHOOK_SECRET=<your_telegram_webhook_secret>
EMAIL_PROVIDER=gmail
EMAIL_FROM_ADDRESS=<alerts@example.com>
GMAIL_CLIENT_ID=<your_gmail_client_id>
GMAIL_CLIENT_SECRET=<your_gmail_client_secret>
GMAIL_REFRESH_TOKEN=<your_gmail_refresh_token>
